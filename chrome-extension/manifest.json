{
  "manifest_version": 3,
  "name": "PZ Mod Manager",
  "version": "0.2.1",
  "description": "Right-click a Project Zomboid Workshop item or collection to install or update it with pzmodmgr.",
  "key": "",
  "permissions": ["contextMenus", "nativeMessaging", "notifications"],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "PZ Mod Manager",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  }
}
