#include <windows.h>

IDI_SETUP ICON "setup.ico"
1 RT_MANIFEST "setup.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 0,2,0,0
 PRODUCTVERSION 0,2,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "pzmodmgr contributors"
            VALUE "FileDescription", "PZ Mod Manager Setup"
            VALUE "FileVersion", "0.2.0"
            VALUE "InternalName", "pzmodmgr-setup"
            VALUE "LegalCopyright", "Copyright (C) 2026 pzmodmgr contributors. GPL-3.0-only."
            VALUE "OriginalFilename", "PZModManager-0.2.0-win64-setup.exe"
            VALUE "ProductName", "PZ Mod Manager"
            VALUE "ProductVersion", "0.2.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
