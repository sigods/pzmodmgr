#include <windows.h>

IDI_SETUP ICON "setup.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @FILEVERSION@
 PRODUCTVERSION @FILEVERSION@
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "pzmodmgr contributors"
            VALUE "FileDescription", "PZ Mod Manager Uninstaller"
            VALUE "FileVersion", "@VERSION@"
            VALUE "InternalName", "pzmodmgr-uninstall"
            VALUE "LegalCopyright", "Copyright (C) 2026 pzmodmgr contributors. GPL-3.0-only."
            VALUE "OriginalFilename", "uninstall.exe"
            VALUE "ProductName", "PZ Mod Manager"
            VALUE "ProductVersion", "@VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
